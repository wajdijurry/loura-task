DATABASE_URL=postgres://loura:loura@localhost:5432/loura
# Dedicated integration-test DB (required; name must end with _test).
# Default host port matches docker compose postgres-test (TEST_POSTGRES_PORT):
TEST_DATABASE_URL=postgres://loura:loura@localhost:5434/loura_test
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Optional host-port overrides when defaults are already in use:
# POSTGRES_PORT=5433
# API_PORT=3080
# TEST_POSTGRES_PORT=5435
# API_BASE_URL=http://127.0.0.1:3080

# Worker — omit to auto-generate a unique per-process id:
# WORKER_ID=worker-local
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=500
JOB_LEASE_MS=30000
MODEL_TIMEOUT_MS=10000
WORKER_SHUTDOWN_GRACE_MS=15000
MAX_CLASSIFICATION_ATTEMPTS=3
FAKE_MODEL_LATENCY_MS=200
CLASSIFIER_VERSION=fake-v1
PROMPT_VERSION=v1
