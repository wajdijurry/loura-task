DATABASE_URL=postgres://loura:loura@localhost:5432/loura
# Dedicated database for integration tests (required; name must end with _test):
TEST_DATABASE_URL=postgres://loura:loura@localhost:5432/loura_test
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Optional host port overrides when 5432/3000 are already in use:
# POSTGRES_PORT=5433
# API_PORT=3080
# API_BASE_URL=http://127.0.0.1:3080

# Worker — omit to auto-generate a unique per-process id:
# WORKER_ID=worker-local
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=500
JOB_LEASE_MS=30000
MODEL_TIMEOUT_MS=10000
WORKER_SHUTDOWN_GRACE_MS=15000
MAX_CLASSIFICATION_ATTEMPTS=3
FAKE_MODEL_LATENCY_MS=200
CLASSIFIER_VERSION=fake-v1
PROMPT_VERSION=v1
